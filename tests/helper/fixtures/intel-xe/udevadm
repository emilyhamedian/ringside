# Fake udevadm for the intel-xe tree, whose 00:02.0 is a Lunar Lake part;
# every other path is answered as common/udevadm answers it.
case $* in
    */intel-xe/sys/devices/pci0000:00/0000:00:02.0)
        echo "ID_MODEL_FROM_DATABASE=Lunar Lake [Intel Arc Graphics 130V / 140V]" ;;
    *) exec "$(dirname "$0")/../common/udevadm" "$@" ;;
esac
