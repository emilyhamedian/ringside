# Fake findmnt: the root file system is a btrfs subvolume, which findmnt
# names after its source as /dev/nvme0n1p2[/@].
case "$*" in
    "-no UUID /") echo "9c0d1e2f-3a4b-4c5d-8e6f-7a8b9c0d1e2f" ;;
    "-no SOURCE /") echo "/dev/nvme0n1p2[/@]" ;;
    *) echo "fake findmnt: unexpected arguments: $*" >&2; exit 1 ;;
esac
